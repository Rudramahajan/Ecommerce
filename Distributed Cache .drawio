        </mxCell>
        <mxCell id="IU5pmkMqKAOoMHPf9lQJ-6" edge="1" parent="1" source="IU5pmkMqKAOoMHPf9lQJ-3" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="dT_7ktCxs0KbFV-aIeWu-6" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="760" y="420" as="sourcePoint" />
            <mxPoint x="810" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
