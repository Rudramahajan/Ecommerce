        <mxCell id="IU5pmkMqKAOoMHPf9lQJ-1" parent="1" style="swimlane;startSize=0;" value="" vertex="1">
          <mxGeometry height="1390" width="1050" x="380" y="660" as="geometry" />
        </mxCell>
        <mxCell id="IU5pmkMqKAOoMHPf9lQJ-2" parent="IU5pmkMqKAOoMHPf9lQJ-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;div class=&quot;pWvJNd&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif; font-size: 14px; font-weight: 400; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;div style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div dir=&quot;ltr&quot; class=&quot;mZJni&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;ul class=&quot;XSq4R KI3fJ&quot; style=&quot;font-size: 16px; margin: 12px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;div class=&quot;pWvJNd&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;div style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div dir=&quot;ltr&quot; class=&quot;mZJni&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;ZLzG0d ncoeY E8xBUb&quot; role=&quot;heading&quot; aria-level=&quot;3&quot; style=&quot;font-size: 20px; font-weight: 600; margin: 24px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;📝 Production Distributed Caching Cheat Sheet&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;AdPoic&quot; aria-level=&quot;4&quot; role=&quot;heading&quot; style=&quot;font-size: 16px; font-weight: 700; margin: 24px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;1. Compute &amp;amp; Infrastructure Layer (AWS)&lt;/div&gt;&lt;ul class=&quot;XSq4R KI3fJ&quot; style=&quot;font-size: 16px; margin: 12px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;ECS Fargate Tasks:&lt;/span&gt; Use serverless containers for identical shards. Configure tasks with &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;uniform RAM sizes&lt;/span&gt; (e.g., 4GB each) to prevent un-balanced resource bottlenecks.&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Network Isolation:&lt;/span&gt; Deploy cache containers hidden inside &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Private Subnets&lt;/span&gt;. Configure AWS Security Groups to accept inbound traffic on port &lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;4001&lt;/code&gt; &lt;em class=&quot;zhvwWe&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;only&lt;/em&gt; from the proxy layer.&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Service Discovery:&lt;/span&gt; Link your ECS service to &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;AWS Cloud Map&lt;/span&gt;. This creates a private domain name (like &lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;node.cache.local&lt;/code&gt;) that tracks changing container IP addresses automatically.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;AdPoic&quot; aria-level=&quot;4&quot; role=&quot;heading&quot; style=&quot;font-size: 16px; font-weight: 700; margin: 24px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;2. Memory Safeguards (Node.js Node Level)&lt;/div&gt;&lt;ul class=&quot;XSq4R KI3fJ&quot; style=&quot;font-size: 16px; margin: 12px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Hard Limits:&lt;/span&gt; Pass the V8 engine space flag (&lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;NODE_OPTIONS=&quot;--max-old-space-size=3072&quot;&lt;/code&gt; for a 4GB task) to prevent Node.js from exceeding container boundaries and throwing an Out-Of-Memory (OOM) error.&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;LRU Eviction Policy:&lt;/span&gt; Never use a standard JavaScript &lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;Map&lt;/code&gt; object forever. Wrap your storage layer with an &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;LRU (Least Recently Used) cache framework&lt;/span&gt;. When memory hits its ceiling, it must automatically drop the oldest keys to prevent crashes.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;AdPoic&quot; aria-level=&quot;4&quot; role=&quot;heading&quot; style=&quot;font-size: 16px; font-weight: 700; margin: 24px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;3. Routing Layer Optimization (NGINX)&lt;/div&gt;&lt;ul class=&quot;XSq4R KI3fJ&quot; style=&quot;font-size: 16px; margin: 12px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Consistent Hashing:&lt;/span&gt; Use the directive &lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;hash $request_uri consistent;&lt;/code&gt;. This tells NGINX to deploy a &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Ketama Hash Ring&lt;/span&gt; using roughly 160 &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Virtual Nodes (vnodes)&lt;/span&gt; per shard to guarantee perfect data distribution across memory pools.&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Failover Controls:&lt;/span&gt; Protect requests by adding &lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;max_fails=3 fail_timeout=10s;&lt;/code&gt; to your backend configuration. If a Fargate node goes down, NGINX skips it immediately and routes the request clockwise to the next available container.&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Persistent Connections:&lt;/span&gt; Add a &lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;keepalive 32;&lt;/code&gt; connection pool inside your upstream block to keep underlying TCP pipelines warm. This eliminates handshake overhead on high-frequency transactions.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;AdPoic&quot; aria-level=&quot;4&quot; role=&quot;heading&quot; style=&quot;font-size: 16px; font-weight: 700; margin: 24px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;4. Resiliency Patterns&lt;/div&gt;&lt;ul class=&quot;XSq4R KI3fJ&quot; style=&quot;font-size: 16px; margin: 12px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Cache Stampede Protection:&lt;/span&gt; Use a &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;single-flight&lt;/span&gt; or mutex-locking strategy in your primary application. If a highly popular key expires, lock database access so only one request hits the main database to refresh the cache value, forcing concurrent incoming queries to wait.&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Replication Strategy:&lt;/span&gt; For ultra-high availability, configure your routing layer or application to perform a &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Dual-Write&lt;/span&gt;. Write incoming keys to their designated target shard &lt;em class=&quot;zhvwWe&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;and&lt;/em&gt; to the next adjacent shard on the ring. If your primary shard crashes, reads remain available on the secondary backup.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;AHmQrc&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;div class=&quot;n6owBd awi2gc&quot; style=&quot;font-size: 16px; margin: 12px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Would you like a sample &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;nginx.conf&lt;/code&gt; snippet showing the failover and keepalive settings&lt;/span&gt;, or a &lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Node.js script demonstrating how to integrate the &lt;code dir=&quot;ltr&quot; class=&quot;KDcb0c&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 1px solid rgb(240, 242, 245);&quot;&gt;lru-cache&lt;/code&gt; package&lt;/span&gt; into your storage logic?&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;SGF5Lb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;SGF5Lb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;SGF5Lb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 14px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 14px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div class=&quot;yhAwj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;SGF5Lb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;SGF5Lb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;SGF5Lb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;span style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif; font-size: 14px; font-weight: 400; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif; font-size: 14px; font-weight: 400; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif; font-size: 14px; font-weight: 400; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;/h1&gt;" vertex="1">
