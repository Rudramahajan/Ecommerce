        </mxCell>
        <mxCell id="AbJ37FA1o0RB3voxti96-26" connectable="0" parent="AbJ37FA1o0RB3voxti96-25" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;div&gt;&amp;nbsp;fetch manifest files and fetch chunks of&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;resolution for&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;adaptive bitrate transmission&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry relative="1" x="-0.2229" as="geometry">
            <mxPoint x="36" y="18" as="offset" />
